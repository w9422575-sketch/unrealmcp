# ===========================================================================
#  agent.env.example  --  copier en "agent.env" pour personnaliser
# ===========================================================================
#  agent.env est ignore par Git (voir .gitignore) : c'est la que doivent
#  aller vos eventuels secrets. AUCUN secret ne doit etre place dans
#  start-agent.ps1, mcp-config.json ou le code des serveurs MCP.
#
#  Format : une paire CLE=VALEUR par ligne. Les lignes vides et celles
#  commencant par # sont ignorees.
# ===========================================================================

# --- Provider (BYOK) -------------------------------------------------------
# Endpoint OpenAI-compatible expose par Ollama.
COPILOT_PROVIDER_BASE_URL=http://localhost:11434/v1
COPILOT_PROVIDER_TYPE=openai
COPILOT_PROVIDER_WIRE_API=completions

# Ollama local n'exige aucune cle. Si vous placez un reverse-proxy
# authentifie devant Ollama, renseignez la cle ICI (jamais dans le code).
# COPILOT_PROVIDER_API_KEY=

# --- Modele ----------------------------------------------------------------
# Modele impose. Ne pas changer sans decision explicite.
COPILOT_MODEL=gpt-oss:20b

# --- Ollama ----------------------------------------------------------------
# 32768 = maximum viable mesure sur RTX 3060 12 Go. 65536 provoque un OOM.
OLLAMA_CONTEXT_LENGTH=32768
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=30m

# --- Unreal ----------------------------------------------------------------
UNREAL_MCP_URL=http://127.0.0.1:8000/mcp
UNREAL_COMPILE_TIMEOUT=1800
